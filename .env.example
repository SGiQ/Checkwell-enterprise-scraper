# =============================================================================
# CheckWell Enterprise Scraper - environment configuration
# =============================================================================
# Copy this file to .env and fill in values. Never commit .env.

# --- Server ---
CWSCRAPER_PORT=5050
CWSCRAPER_HOST=0.0.0.0
CWSCRAPER_SECRET=change-me-to-a-long-random-string

# --- Data + niche pack ---
# Directory for JSON state (leads, seen IDs, config, replies). Created if missing.
CWSCRAPER_DATA_DIR=./data
# Which niche pack to load from src/cwscraper/niches/<name>.yaml
CWSCRAPER_NICHE=caregiver

# --- Optional: SGiQ CRM lead push --------------------------------------------
# When both are set, every directory scan (and each enrichment pass) pushes its
# business leads to the SGiQ CRM ingestion API. Best-effort: a failure here logs
# a warning and never aborts a scan. Mint the key in the CRM's Integrations page.
SGIQ_CRM_URL=
SGIQ_CRM_API_KEY=
# Optional request timeout in seconds (default 15).
SGIQ_CRM_TIMEOUT=15

# --- Inbound auth: SGiQ CRM -> scraper send service --------------------------
# Shared secret the CRM sends in the X-CRM-Key header on POST
# /api/emails/send-external. Must EXACTLY equal SCRAPER_EMAIL_KEY in the CRM.
# Generate a long random string; set the real value in Railway.
CRM_INBOUND_KEY=

# --- Optional: YouTube Data API v3 ---
# Without this, YouTube scanner falls back to RSS feeds of well-known channels.
YOUTUBE_API_KEY=

# --- Optional: Google Places API (New) — for directory-mode niche packs ---
# Required if CWSCRAPER_NICHE is a directory-mode pack (e.g. senior_care_agencies_se).
# Enable "Places API (New)" at https://console.cloud.google.com/apis/library/places.googleapis.com
# Free tier: $200/mo credit covers ~5,700 text-search requests.
GOOGLE_PLACES_API_KEY=

# --- Optional: Reddit OAuth for posting replies ---
# Create app at https://www.reddit.com/prefs/apps (type: web app)
# Redirect URI must match CWSCRAPER_REDDIT_REDIRECT_URI below.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
CWSCRAPER_REDDIT_REDIRECT_URI=http://localhost:5050/auth/reddit/callback

# --- Optional: Email scheduler (cold email sends from the dashboard) ---
# Without these, the dashboard's "Schedule send" is disabled and only the
# mailto: option works (you send manually from your real mail client).
#
# Pick ONE of the two transports below (or set EMAIL_TRANSPORT to force one
# when both are configured). The dashboard preflight banner tells you which
# is active.

# Option A — SMTP (works for Gmail, Workspace, Outlook, Mailgun, etc.)
# Best for: low-volume cold outreach where you want to send FROM your real
# address (no DKIM/SPF setup, uses your account's existing reputation).
# Gmail caps: 500/day free, 2000/day Workspace. Exceeding triggers spam flags.
#
# Gmail/Workspace setup:
#   1. Enable 2FA on the Google account (required for App Passwords)
#   2. Generate a 16-char App Password: https://myaccount.google.com/apppasswords
#   3. Set the four vars below with the App Password (NOT your account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Option B — Resend (https://resend.com)
# Best for: higher volume + when you want a separate reputation from your
# main inbox. Free 3k/mo. Requires a verified sender domain (SPF + DKIM).
RESEND_API_KEY=

# Used by both transports. CWSCRAPER_FROM_EMAIL defaults to SMTP_USER when
# unset (for SMTP). Set it explicitly when using Resend.
CWSCRAPER_FROM_EMAIL=
CWSCRAPER_FROM_NAME=

# Optional: force a specific transport when both Resend + SMTP are configured.
# Values: 'smtp' or 'resend'. Default (auto): SMTP wins if configured, then Resend.
EMAIL_TRANSPORT=

# --- Optional: Inbound reply polling (IMAP) ---------------------------------
# Closes the outreach loop: the background poller fetches UNSEEN replies on
# IMAP_POLL_MINUTES, classifies each one, and auto-advances the matched
# prospect's pipeline_stage:
#   interested      -> reply_received
#   not_interested  -> lost
#   unsubscribe     -> lost + added to suppression list
#   bounce          -> sender added to suppression list
#   out_of_office   -> activity log only (no stage change)
#   unclear         -> activity log only (operator triages from dashboard)
#
# Single-mailbox providers (Hostinger, Workspace, Outlook, etc.) usually share
# creds between SMTP and IMAP — leave IMAP_USER + IMAP_PASSWORD blank to fall
# back to SMTP_USER / SMTP_PASSWORD.
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=10

# --- Optional: Public unsubscribe URL ---------------------------------------
# When set, every outbound email gets List-Unsubscribe + List-Unsubscribe-Post
# headers (RFC 8058 one-click in Gmail/Outlook). Recipients who hit the URL
# (or click "Unsubscribe" in their mail client) are added to the suppression
# list automatically and matched prospects are marked 'lost'.
#
# The route /unsubscribe is served by this app — point this var at wherever
# your dashboard is reachable from the public internet (e.g. your Railway URL).
# Required to avoid CAN-SPAM violations for cold outreach.
CWSCRAPER_UNSUBSCRIBE_URL=

# --- Optional: AI personalizer (Claude Haiku 4.5) ---------------------------
# When set, the bulk drafter runs each recipient through Claude Haiku 4.5 to
# generate a unique 1-2 sentence opener (the {personalized_opener} template
# variable). Costs ~$0.001 per email — about $1 to personalize 1000 leads.
# Templates that don't use {personalized_opener} are unaffected.
#
# Without this set, the bulk drafter still works — it falls back to a
# generic regional opener ("Acme Care's work in Tucson caught our attention…")
# so drafting never fails on a missing API key.
ANTHROPIC_API_KEY=

# Optional: override the model. Default is claude-haiku-4-5.
CWSCRAPER_PERSONALIZER_MODEL=

# --- Optional: Auto-drafted second-touch reply CTAs --------------------------
# When the IMAP poller classifies an inbound reply as 'interested',
# the system auto-drafts a response. If these links are set, the drafter
# offers them as concrete next-step options (booking + demo). Both are
# optional — if neither is set, the drafter falls back to a simpler
# "what's the easiest next step for you?" question.
#
# The drafter never auto-SENDS. Drafts are queued for operator review on
# the Replies tab. Approve or dismiss before anything goes out.
CWSCRAPER_BOOKING_LINK=
CWSCRAPER_DEMO_VIDEO_LINK=

# --- Optional: Send-volume hygiene -------------------------------------------
# Three independent guardrails that protect sender reputation on cold outreach.
# Defaults are conservative and appropriate for a fresh mailbox.

# Hard cap on total emails (sent + pending in queue) per UTC day. Hostinger
# throttles around 250–500/day; Gmail/Outlook spam-fold high-velocity batches.
# Default 50.
CWSCRAPER_SEND_DAILY_CAP=50

# Cap on emails to any single recipient domain in one UTC day. Prevents the
# "20 cold emails to @gmail.com in one hour" pattern that triggers Gmail's
# bulk-detection. Default 5.
CWSCRAPER_SEND_PER_DOMAIN_DAILY_CAP=5

# Warm-up curve: for the first 14 days after the first send, the daily cap
# is staged automatically — 10/day for week 1, 25/day for week 2, then the
# full base cap. Set to 'true' to disable the curve entirely (advanced —
# only do this on an already-warm sending domain).
CWSCRAPER_SEND_WARMUP_DISABLED=false
